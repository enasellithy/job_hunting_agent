# API Keys
OPENAI_API_KEY=your_openai_api_key_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Email Configuration (Yahoo SMTP)
SMTP_SERVER=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_ADDRESS=your_email@yahoo.com
EMAIL_PASSWORD=your_app_specific_password_here

# LinkedIn Credentials
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# Google Drive Service Account Configuration
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json
# OR use environment variable with JSON content:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
MASTER_CV_NAME=Enas Ahmed - Master CV

# Search Configuration
TARGET_REGIONS=Egypt,KSA,UAE,EU
TARGET_ROLES=Tech Lead,Software Architect,Engineering Manager
MIN_EXPERIENCE_YEARS=9
MATCH_THRESHOLD=85
